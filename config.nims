switch("d", "useMalloc")
switch("d", "noSignalHandler")
switch("path", "lib/compose")
switch("path", "lib/unlibc/src")
switch("path", "lib/uefi")
switch("path", "src")
switch("mm", "arc")
switch("os", "any")
switch("cpu", "amd64")
switch("nimcache", "build/c")
switch("threads", "off")
switch("cc", "clang")
switch("passC", "-fno-stack-protector -ffreestanding -mno-stack-arg-probe -I ./lib/unlibc/include --target=x86_64-uefi")
switch("passL", "--target=x86_64-uefi")
switch("verbosity", "1")
put("amd64.any.clang.path", "tools")
put("amd64.any.clang.exe", "cc")
put("amd64.any.clang.linkerexe", "cc")
put("amd64.any.clang.options.linker", "")
